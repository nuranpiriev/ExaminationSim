@model ICollection<CartItem>
<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Item Tables</h6>
    </div>
    <div class="card-body">
        <a class="button" asp-action="Create">
            <i class="btn btn-primary"></i>
            <span>  Create</span>
        </a>
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Is Deleted?</th>
                        <th>Image URl</th>
                        <th>Icon URl</th>
                        <th>Created at</th>
                        <th>Updated at</th>
                        <th>Deleted at</th>
                        <th>Operations</th>

                        
                    </tr>
                </thead>
                
                <tbody>
                    @foreach(var item in Model)
                    {
                      
                            string? Update = (item.UpdatedAt is null) ? "-" : item.UpdatedAt.ToString();
                            string? Delete = (item.DeletedAt is null) ? "-" : item.DeletedAt.ToString();
                        
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>@item.IsDeleted</td>
                            <td>@item.ImageUrl</td>
                            <td>@item.IconUrl</td>
                            <td>@item.CreatedAt</td>
                            <td>@(Update)</td>
                            <td>@Delete</td>
                            <td>
                                <a class="button" asp-controller="CartItem" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="btn btn-primary"></i>
                                    <span>Update</span>
                                </a>
                                <a class="button"asp-controller="CartItem" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="btn btn-danger"></i>
                                    <span>  Delete</span>
                                </a>

                            </td>
                           
                               
                        </tr>
                        
                    }
                   
                </tbody>
            </table>
        </div>
    </div>
</div>